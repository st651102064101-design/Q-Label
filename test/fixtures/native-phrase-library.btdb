<?xml version="1.0" standalone="yes"?>
<BtDataSet xmlns="http://tempuri.org/BtDataSet.xsd">
  <xs:schema id="BtDataSet" targetNamespace="http://tempuri.org/BtDataSet.xsd" xmlns:mstns="http://tempuri.org/BtDataSet.xsd" xmlns="http://tempuri.org/BtDataSet.xsd" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:msdata="urn:schemas-microsoft-com:xml-msdata" attributeFormDefault="qualified" elementFormDefault="qualified">
    <xs:element name="BtDataSet" msdata:IsDataSet="true" msdata:UseCurrentLocale="true" msdata:HadTableTypesColumn="False">
      <xs:complexType>
